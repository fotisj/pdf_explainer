{
  "name": "pdf-explainer",
  "version": "1.0.1",
  "description": "AI-enhanced PDF reader that explains highlighted text and saves the explanation as a real PDF annotation",
  "main": "src/main/main.js",
  "scripts": {
    "start": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron .",
    "dev": "webpack --watch",
    "build": "webpack --mode production",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [],
  "author": {
    "name": "Adrian Rubio-Punal",
    "email": "adrian.rubio.punal@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "electron-store": "^8.1.0",
    "katex": "^0.18.5",
    "openai": "^4.98.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.2.133",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.1.3",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dotenv": "^18.0.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.yourname.pdf-explainer",
    "productName": "PDF Explainer",
    "icon": "resources/icon",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
